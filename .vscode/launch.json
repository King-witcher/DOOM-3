{
    // Build + run Doom 3 from VS Code.
    //
    // Requires the C/C++ extension (ms-vscode.cpptools) for the cppvsdbg debugger.
    //
    // Doom 3 renders with OpenGL (not Direct3D); input/sound use DirectInput8 +
    // DirectSound, which ship in the modern Windows SDK. The legacy DirectX SDK
    // (June 2010) is NOT needed anymore -- DxErr was replaced by a local shim
    // and the one EAX GUID is defined in snd_system.cpp.
    //
    // NO QVM: unlike Quake III, Doom 3 has no bytecode VM. Game logic is always
    // a native DLL (gamex86.dll) -- there is nothing to "interpret", so there is
    // only one run mode, native.
    //
    // Dev workflow (mirrors the run\dev mod of the Quake III sibling):
    //   run\base   -> symlink to the retail Doom 3 install (the game assets)
    //   run\dev    -> our freshly built gamex86.dll (deployed by build-doom3.ps1)
    //
    //   fs_basepath = run, fs_game = dev makes the engine search run\dev before
    //   run\base, so OUR game DLL overrides the retail base\gamex86.dll. The
    //   preLaunchTask builds AND deploys the DLL into run\dev before launching.
    //   si_pure 0 lets the engine load our loose (non-pak) DLL.
    "version": "0.2.0",
    "configurations": [
        {
            "name": "DOOM 3 — Debug",
            "type": "cppvsdbg",
            "request": "launch",
            "preLaunchTask": "msbuild: doom3 (Debug)",
            "program": "${workspaceFolder}\\build\\Win32\\Debug\\DOOM3.exe",
            "cwd": "${workspaceFolder}\\build\\Win32\\Debug",
            "args": [
                "+set", "fs_basepath", "${workspaceFolder}\\run",
                "+set", "fs_game", "dev",
                "+set", "com_allowConsole", "1",
                "+set", "si_pure", "0",
                "+set", "developer", "1"
            ],
            "console": "integratedTerminal",
            "stopAtEntry": false
        },
        {
            "name": "DOOM 3 — Release",
            "type": "cppvsdbg",
            "request": "launch",
            "preLaunchTask": "msbuild: doom3 (Release)",
            "program": "${workspaceFolder}\\build\\Win32\\Release\\DOOM3.exe",
            "cwd": "${workspaceFolder}\\build\\Win32\\Release",
            "args": [
                "+set", "fs_basepath", "${workspaceFolder}\\run",
                "+set", "fs_game", "dev",
                "+set", "si_pure", "0"
            ],
            "console": "integratedTerminal",
            "stopAtEntry": false
        },

        //
        // ===== Quake 4 ======================================================
        // Run the engine against Raven's retail Quake 4 assets + game DLL.
        //   * preLaunchTask builds the engine and deploys q4base\gamex86.dll
        //     (GAME_API_VERSION 37) next to DOOM3.exe.
        //   * fs_basepath -> run\q4 (a junction to the Quake 4 install) so the
        //     engine mounts q4base\*.pk4. fs_game q4base targets Quake 4 assets.
        //   * fs_savepath -> run\q4save keeps logs/configs out of Program Files
        //     (qconsole.log lands in run\q4save\q4base\).
        //   * si_pure 0 lets the engine load the loose retail game DLL.
        // NOTE: while the port is at "milestone 1", the engine intentionally
        // halts right after "GetGameAPI version 37 accepted" (see Common.cpp
        // LoadGameDLL). That halt goes away as the idGame/idCommon ports land.
        //
        {
            "name": "Quake 4 — Debug",
            "type": "cppvsdbg",
            "request": "launch",
            "preLaunchTask": "msbuild: quake4 (Debug)",
            "program": "${workspaceFolder}\\build\\Win32\\Debug\\DOOM3.exe",
            "cwd": "${workspaceFolder}\\build\\Win32\\Debug",
            "args": [
                "+set", "fs_basepath", "${workspaceFolder}\\run\\q4",
                "+set", "fs_game", "q4base",
                "+set", "fs_savepath", "${workspaceFolder}\\run\\q4save",
                "+set", "si_pure", "0",
                "+set", "fs_restrict", "0",
                "+set", "developer", "1",
                "+set", "com_allowConsole", "1",
                "+set", "logFile", "2",
                "+set", "r_fullscreen", "0"
            ],
            "console": "integratedTerminal",
            "stopAtEntry": false
        },
        {
            "name": "Quake 4 — Release",
            "type": "cppvsdbg",
            "request": "launch",
            "preLaunchTask": "msbuild: quake4 (Release)",
            "program": "${workspaceFolder}\\build\\Win32\\Release\\DOOM3.exe",
            "cwd": "${workspaceFolder}\\build\\Win32\\Release",
            "args": [
                "+set", "fs_basepath", "${workspaceFolder}\\run\\q4",
                "+set", "fs_game", "q4base",
                "+set", "fs_savepath", "${workspaceFolder}\\run\\q4save",
                "+set", "si_pure", "0",
                "+set", "fs_restrict", "0",
                "+set", "r_fullscreen", "0"
            ],
            "console": "integratedTerminal",
            "stopAtEntry": false
        }
    ]
}
